# dev | stage | prod — selects which API_BASE_URL_* is used by the app
APP_ENV=dev

# API endpoints
API_BASE_URL_DEV=http://localhost:8000
API_BASE_URL_STAGE=https://stage.api.Flyro.local
API_BASE_URL_PROD=https://api.Flyro.com

# Feature toggles (client-side)
ENABLE_LOGGING=true
ENABLE_OFFLINE_QUEUE=true
ENABLE_AI_CHAT=true

# Display/localization
DEFAULT_CURRENCY=PKR
DEFAULT_TIMEZONE=Asia/Karachi
