# Core
APP_NAME=Flyro
TIMEZONE=Asia/Karachi
CURRENCY=PKR
ENV=dev
API_DOCS_ENABLED=true

# Database
DB_URL=sqlite:///./Flyro.db

# Auth/JWT
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=
JWT_AUDIENCE=
PASSWORD_MIN_LENGTH=8

# OTP (email)
OTP_SENDER_EMAIL=no-reply@Flyro.local
OTP_SMTP_HOST=localhost
OTP_SMTP_PORT=1025
OTP_SMTP_USER=
OTP_SMTP_PASS=
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=3
OTP_TTL_SECONDS=300
OTP_BCRYPT_ROUNDS=12
OTP_THROTTLE_WINDOW_SECONDS=60
OTP_THROTTLE_LIMIT=3

# Media
MEDIA_ROOT=./media
MEDIA_BASE_URL=/media
STATIC_ROOT=./static
MIGRATION_REQUIRED_STRICT=true
REQUEST_RETRY_ATTEMPTS=3
SECURITY_HEADERS_ENABLED=true
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# MinIO (optional)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false

# Google Sign-In
GOOGLE_CLIENT_ID=

# AviationStack (flight tracking)
AVIATIONSTACK_API_KEY=

# Gemini AI (fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM (primary LLM — MiniMax-M2.5)
NVIDIA_API_KEY=
NVIDIA_MODEL=minimaxai/minimax-m2.5

# OpenAI (fallback LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Feature flags
FEATURE_ESCROW_SIM=true
FEATURE_AI_READONLY=true

# Admin web login cookie
ADMIN_COOKIE_NAME=Flyro_admin_access
ADMIN_SESSION_MINUTES=480
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_SAMESITE=strict
